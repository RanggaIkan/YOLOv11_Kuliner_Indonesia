# ==============================================================================
# NusantaraVision YOLOv11 - Indonesian Culinary Detection & Image Enhancement
# Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local backend / Colab usage.
# NEVER commit `.env` or expose `SUPABASE_SERVICE_ROLE_KEY` in frontend code!

# Supabase Project URL (e.g., https://abcdefghijklmno.supabase.co or http://127.0.0.1:54321)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable Key (preferred for new projects) or Legacy Anon Key
# Safe for browser / frontend usage when Row Level Security (RLS) is enabled.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_legacy_anon_key_here

# Roboflow API Key (used in Google Colab notebook to download the 600-image dataset)
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=nusantaravision-tas
ROBOFLOW_PROJECT=indonesian-culinary-12
ROBOFLOW_VERSION=1

# Model & Server Configuration
YOLO_MODEL_PATH=models/best.pt
YOLO_FALLBACK_MODEL=yolo11n.pt
LOCAL_DB_FALLBACK_PATH=reports/local_db_fallback.json
PORT=8000
